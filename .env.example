# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file — it is already listed in .gitignore.

ENV=development

# SQLite by default. Swap to Postgres/MySQL by changing this URL only.
DATABASE_URL=sqlite:///./app/data/documents.db

# Required: get a free key (no billing/credit card needed) at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OCR backend (only "tesseract" is wired up)
OCR_BACKEND=tesseract

# Only needed if `tesseract`/`pdftoppm` aren't found on PATH (common on
# Windows — see README "Windows setup note"). Leave blank on Linux/macOS/Docker.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

# Upload constraints
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# Absolute variance tolerance (currency units) for financial checks
VALIDATION_TOLERANCE=1.0

LOG_LEVEL=INFO
